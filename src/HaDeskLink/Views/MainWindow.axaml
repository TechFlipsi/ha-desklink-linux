<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HaDeskLink.Views.MainWindow"
        Title="HA DeskLink Linux"
        Width="560" Height="520"
        WindowStartupLocation="CenterScreen"
        MinWidth="450" MinHeight="400">

    <DockPanel Margin="20">
        <!-- Title -->
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="🏠 HA DeskLink Linux" FontSize="22" FontWeight="Bold" />
            <TextBlock Name="LblVersion" Text="v4.3.0" FontSize="12" Foreground="Gray" />
        </StackPanel>

        <!-- Status -->
        <Border DockPanel.Dock="Top" Background="#1E1E1E" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <StackPanel Spacing="6">
                <TextBlock Text="📊 Status" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Name="LblStatus" Text="✓ Verbunden" Foreground="#4CAF50" FontSize="13" />
                <TextBlock Name="LblSensors" Text="Sensoren: 0 registriert" Foreground="Gray" FontSize="12" />
            </StackPanel>
        </Border>

        <!-- Dashboard link -->
        <Border DockPanel.Dock="Top" Background="#2D2D2D" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <StackPanel Spacing="8">
                <TextBlock Text="🌐 Home Assistant Dashboard" FontWeight="SemiBold" FontSize="14" />
                <Button Name="BtnDashboard" Content="Dashboard öffnen" HorizontalAlignment="Stretch" ToolTip.Tip="Home Assistant Dashboard im eingebetteten WebView öffnen" />
            </StackPanel>
        </Border>

        <!-- MQTT Settings -->
        <Border DockPanel.Dock="Top" Background="#1E1E1E" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <StackPanel Spacing="6">
                <TextBlock Text="📡 MQTT-Einstellungen" FontWeight="SemiBold" FontSize="14" />
                <CheckBox Name="ChkMqttEnabled" Content="MQTT aktivieren" />
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                    <TextBlock Text="Broker:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="Gray" FontSize="12" />
                    <TextBox Name="TxtMqttBroker" Grid.Row="0" Grid.Column="1" Margin="4,2" Text="" />
                    <TextBlock Text="Port:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="Gray" FontSize="12" />
                    <TextBox Name="TxtMqttPort" Grid.Row="1" Grid.Column="1" Margin="4,2" Text="1883" />
                    <TextBlock Text="Benutzername:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="Gray" FontSize="12" />
                    <TextBox Name="TxtMqttUser" Grid.Row="2" Grid.Column="1" Margin="4,2" Text="" />
                    <TextBlock Text="Passwort:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Foreground="Gray" FontSize="12" />
                    <TextBox Name="TxtMqttPass" Grid.Row="3" Grid.Column="1" Margin="4,2" Text="" PasswordChar="•" />
                    <TextBlock Text="Fallback-Adresse:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Foreground="Gray" FontSize="12" />
                    <TextBox Name="TxtMqttFallback" Grid.Row="4" Grid.Column="1" Margin="4,2" Text="" ToolTip.Tip="Alternative MQTT-Broker-Adresse (z.B. lokale IP), falls die Hauptadresse nicht erreichbar ist" />
                </Grid>
                <CheckBox Name="ChkMqttSsl" Content="SSL/TLS verwenden" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Name="BtnMqttTest" Content="🔌 Verbindung testen" ToolTip.Tip="MQTT-Verbindung mit den aktuellen Einstellungen testen" />
                    <Button Name="BtnMqttSave" Content="💾 Speichern" ToolTip.Tip="MQTT-Einstellungen speichern" />
                </StackPanel>
                <TextBlock Name="LblMqttStatus" Text="" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,14">
            <TextBlock Text="⚡ Aktionen" FontWeight="SemiBold" FontSize="14" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Name="BtnRefresh" Content="🔄 Sensoren aktualisieren" ToolTip.Tip="Alle Sensoren neu auslesen und an Home Assistant senden" />
                <Button Name="BtnQuickActions" Content="⚡ Quick Actions" ToolTip.Tip="Konfigurierte HA-Entitäten schnell ein-/ausschalten" />
                <Button Name="BtnSetup" Content="⚙️ Einrichtung" ToolTip.Tip="Home Assistant URL und Token konfigurieren" />
                <Button Name="BtnResetDevice" Content="🔑 Neue Geräte-ID" ToolTip.Tip="Erzeugt eine neue Geräte-ID – App muss danach neu gestartet werden" />
            </StackPanel>
        </StackPanel>

        <!-- Links -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,0,0,4">
            <Button Name="BtnDiscord" Content="💬 Discord" ToolTip.Tip="Community Discord Server – Fragen, Feedback &amp; Hilfe" />
            <Button Name="BtnGitHub" Content="📦 GitHub" ToolTip.Tip="HA DeskLink auf GitHub – Releases, Quellcode &amp; Issues" />
        </StackPanel>

        <!-- Info -->
        <TextBlock DockPanel.Dock="Bottom" Text="HA DeskLink läuft als Hintergrund-Dienst (systemd)"
                   Foreground="Gray" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0" />
    </DockPanel>
</Window>