<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HaDeskLink.Views.MainWindow"
        Title="HA DeskLink"
        Width="1100" Height="720"
        WindowStartupLocation="CenterScreen"
        MinWidth="820" MinHeight="560"
        Background="#0F1117"
        FontFamily="Inter, Segoe UI, Noto Sans">

    <Window.Styles>
        <!-- ── Neues Design-System: flach, modern, ruhig ── -->
        <Style Selector="Button.nav">
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B7BCC8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1C2230"/>
        </Style>
        <Style Selector="Button.nav.active /template/ ContentPresenter">
            <Setter Property="Background" Value="#24304A"/>
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="#161A24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E8EBF0"/>
        </Style>
        <Style Selector="TextBlock.desc">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7A8194"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style Selector="TextBlock.lbl">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#C4C9D4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="220,*">
        <!-- ═══ EINE Sidebar für ALLE Ansichten ═══ -->
        <Border Grid.Column="0" Background="#12141C">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,20">
                    <TextBlock Text="HA DeskLink" FontSize="17" FontWeight="Bold" Foreground="#F2F4F8"/>
                    <TextBlock Name="LblVersion" Text="v5.1.0" FontSize="11" Foreground="#5C6270" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="10,0">
                    <Button Name="NavDashboard" Classes="nav">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Dashboard" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="NavQuickActions" Classes="nav">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Quick Actions" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="NavMusic" Classes="nav">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎵" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Musik" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="NavWidgets" Classes="nav">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧩" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Widgets" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="NavSettings" Classes="nav">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Einstellungen" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,16" Spacing="6">
                    <Button Name="NavRefresh" Classes="nav" Content="🔄  Sensoren aktualisieren" FontSize="12" Height="34"/>
                    <Button Name="NavDiscord" Classes="nav" Content="💬  Discord" FontSize="12" Height="34"/>
                    <Button Name="NavGitHub" Classes="nav" Content="📦  GitHub" FontSize="12" Height="34"/>
                </StackPanel>
                <Border/>
            </DockPanel>
        </Border>

        <!-- ═══ Content-Host: EIN View-Layer ═══ -->
        <!-- Das Dashboard läuft in einem EIGENEN Fenster (DashboardWindow.Open) —
             dadurch gibt es KEIN eingebettetes GTK-WebView im Hauptfenster mehr:
             kein Durchscheinen, kein Ghost-Fenster, keine GTK-Crash-Kette. -->
        <Border Grid.Column="1" Padding="22,20" Background="#0F1117">
            <ContentControl Name="ViewHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Border>
    </Grid>
</Window>