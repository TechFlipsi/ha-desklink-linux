<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HaDeskLink.Views.MainWindow"
        Title="HA DeskLink Linux"
        Width="500" Height="420"
        WindowStartupLocation="CenterScreen"
        MinWidth="400" MinHeight="350">

    <DockPanel Margin="16">
        <!-- Title -->
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="🏠 HA DeskLink Linux" FontSize="20" FontWeight="Bold" />
            <TextBlock Name="LblVersion" Text="v2.1.1" FontSize="12" Foreground="Gray" />
        </StackPanel>

        <!-- Status -->
        <Border DockPanel.Dock="Top" Background="#1E1E1E" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel Spacing="6">
                <TextBlock Text="Status" FontWeight="SemiBold" />
                <TextBlock Name="LblStatus" Text="✓ Verbunden" Foreground="#4CAF50" />
                <TextBlock Name="LblSensors" Text="Sensoren: 0 registriert" Foreground="Gray" FontSize="12" />
            </StackPanel>
        </Border>

        <!-- Dashboard link -->
        <Border DockPanel.Dock="Top" Background="#2D2D2D" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel Spacing="6">
                <TextBlock Text="Home Assistant Dashboard" FontWeight="SemiBold" />
                <Button Name="BtnDashboard" Content="🌐 Dashboard öffnen" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
            <Button Name="BtnRefresh" Content="🔄 Sensoren aktualisieren" />
            <Button Name="BtnQuickActions" Content="⚡ Quick Actions" />
            <Button Name="BtnSetup" Content="⚙️ Einrichtung" />
            <Button Name="BtnResetDevice" Content="🔑 Neue Geräte-ID" />
        </StackPanel>

        <!-- Links -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,0,0,4">
            <Button Name="BtnDiscord" Content="💬 Discord" />
            <Button Name="BtnGitHub" Content="📦 GitHub" />
        </StackPanel>

        <!-- Info -->
        <TextBlock DockPanel.Dock="Bottom" Text="HA DeskLink läuft als Hintergrund-Dienst (systemd)" 
                   Foreground="Gray" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0" />
    </DockPanel>
</Window>